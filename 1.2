using System;
using System.Collections.Generic;
using System.Diagnostics;
using System.IO;
using System.Threading;

class Program
{
    private const int SetCount = 15;
    private const int NumbersInSet = 100;
    private const string FileName = "numbers.txt";

    private static readonly List<string> log = new List<string>();
    private static readonly object logLocker = new object();

    private static readonly Mutex totalMutex = new Mutex();
    private static int totalSum = 0;

    private static Semaphore semaphore;

    static void Main()
    {
        Console.WriteLine("Задание 1.2");

        Console.Write("Введите максимальное количество потоков n: ");
        int n = int.Parse(Console.ReadLine());

        semaphore = new Semaphore(n, n);

        if (!File.Exists(FileName))
        {
            GenerateNumberSets();
            Console.WriteLine($"Файл {FileName} создан.");
        }

        List<int[]> sets = ReadNumberSets();

        Thread[] threads = new Thread[sets.Count];

        Stopwatch stopwatch = Stopwatch.StartNew();

        for (int i = 0; i < sets.Count; i++)
        {
            int setNumber = i + 1;
            int[] numbers = sets[i];

            threads[i] = new Thread(() =>
            {
                ProcessSet(setNumber, numbers);
            });

            threads[i].Start();
        }

        for (int i = 0; i < threads.Length; i++)
        {
            threads[i].Join();
        }

        stopwatch.Stop();

        Console.WriteLine();
        Console.WriteLine("Результаты подсчёта:");

        foreach (string item in log)
        {
            Console.WriteLine(item);
        }

        Console.WriteLine();
        Console.WriteLine($"Общий итог всех сумм: {totalSum}");
        Console.WriteLine($"Время выполнения: {stopwatch.ElapsedMilliseconds} мс");
    }

    static void GenerateNumberSets()
    {
        Random random = new Random();

        using StreamWriter writer = new StreamWriter(FileName);

        for (int i = 0; i < SetCount; i++)
        {
            List<int> numbers = new List<int>();

            for (int j = 0; j < NumbersInSet; j++)
            {
                numbers.Add(random.Next(1, 101));
            }

            writer.WriteLine(string.Join(" ", numbers));
        }
    }

    static List<int[]> ReadNumberSets()
    {
        List<int[]> sets = new List<int[]>();

        string[] lines = File.ReadAllLines(FileName);

        foreach (string line in lines)
        {
            string[] parts = line.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            int[] numbers = new int[parts.Length];

            for (int i = 0; i < parts.Length; i++)
            {
                numbers[i] = int.Parse(parts[i]);
            }

            sets.Add(numbers);
        }

        return sets;
    }

    static void ProcessSet(int setNumber, int[] numbers)
    {
        semaphore.WaitOne();

        try
        {
            int sum = 0;

            foreach (int number in numbers)
            {
                sum += number;
            }

            int threadId = Thread.CurrentThread.ManagedThreadId;

            lock (logLocker)
            {
                log.Add($"Набор {setNumber}: сумма = {sum}, поток = {threadId}");
            }

            totalMutex.WaitOne();
            try
            {
                totalSum += sum;
            }
            finally
            {
                totalMutex.ReleaseMutex();
            }
        }
        finally
        {
            semaphore.Release();
        }
    }
}
