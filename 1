using System;
using System.Collections.Generic;

// Элементы документа 
interface IElement
{
    void Accept(IVisitor visitor);
}

class Paragraph : IElement
{
    public string Text { get; set; }
    public Paragraph(string text) => Text = text;

    public void Accept(IVisitor visitor)
    {
        visitor.Visit(this);
    }
}

class Image : IElement
{
    public string Path { get; set; }
    public Image(string path) => Path = path;

    public void Accept(IVisitor visitor)
    {
        visitor.Visit(this);
    }
}

class Table : IElement
{
    public string[,] Data { get; set; }
    public Table(string[,] data) => Data = data;

    public void Accept(IVisitor visitor)
    {
        visitor.Visit(this);
    }
}

// Visitor
interface IVisitor
{
    void Visit(Paragraph paragraph);
    void Visit(Image image);
    void Visit(Table table);
}

// Конкретные Visitors
class HtmlExportVisitor : IVisitor
{
    public void Visit(Paragraph paragraph)
    {
        Console.WriteLine($"<p>{paragraph.Text}</p>");
    }

    public void Visit(Image image)
    {
        Console.WriteLine($"<img src='{image.Path}' />");
    }

    public void Visit(Table table)
    {
        Console.WriteLine("<table>");
        for (int i = 0; i < table.Data.GetLength(0); i++)
        {
            Console.WriteLine("<tr>");
            for (int j = 0; j < table.Data.GetLength(1); j++)
                Console.WriteLine($"<td>{table.Data[i, j]}</td>");
            Console.WriteLine("</tr>");
        }
        Console.WriteLine("</table>");
    }
}

class MarkdownExportVisitor : IVisitor
{
    public void Visit(Paragraph paragraph)
    {
        Console.WriteLine(paragraph.Text + "\n");
    }

    public void Visit(Image image)
    {
        Console.WriteLine($"![Image]({image.Path})");
    }

    public void Visit(Table table)
    {
        for (int i = 0; i < table.Data.GetLength(0); i++)
        {
            for (int j = 0; j < table.Data.GetLength(1); j++)
                Console.Write($"{table.Data[i, j]} | ");
            Console.WriteLine();
        }
        Console.WriteLine();
    }
}

// Клиентский код
class Document
{
    public List<IElement> Elements { get; set; } = new List<IElement>();

    public void Export(IVisitor visitor)
    {
        foreach (var element in Elements)
            element.Accept(visitor);
    }
}

// Пример использования
class Program
{
    static void Main()
    {
        var doc = new Document();
        doc.Elements.Add(new Paragraph("Hello World"));
        doc.Elements.Add(new Image("image.png"));
        doc.Elements.Add(new Table(new string[,] { { "A", "B" }, { "1", "2" } }));

        Console.WriteLine("HTML Export:");
        doc.Export(new HtmlExportVisitor());

        Console.WriteLine("\nMarkdown Export:");
        doc.Export(new MarkdownExportVisitor());
    }
}

