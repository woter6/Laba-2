using System;
using System.Diagnostics;
using System.IO;
using System.Net.Http;

class Program
{
    static void Main()
    {
        Console.WriteLine("Задание 2. Синхронная версия");

        string[] urls =
        {
            "https://jsonplaceholder.typicode.com/posts/1",
            "https://api.github.com/repos/dotnet/runtime",
            "https://catfact.ninja/fact"
        };

        Stopwatch stopwatch = Stopwatch.StartNew();

        try
        {
            using HttpClient client = new HttpClient();
            client.DefaultRequestHeaders.UserAgent.ParseAdd("CSharpConsoleApp");

            foreach (string url in urls)
            {
                string json = GetJsonSync(client, url);

                Console.WriteLine();
                Console.WriteLine($"Ответ от сервера: {url}");
                Console.WriteLine(json);
            }

            stopwatch.Stop();

            Console.WriteLine();
            Console.WriteLine($"Общее время работы: {stopwatch.ElapsedMilliseconds} мс");
        }
        catch (Exception ex)
        {
            stopwatch.Stop();

            Console.WriteLine();
            Console.WriteLine("Ошибка при выполнении запроса:");
            Console.WriteLine(ex.Message);
            Console.WriteLine($"Время до ошибки: {stopwatch.ElapsedMilliseconds} мс");
        }
    }

    static string GetJsonSync(HttpClient client, string url)
    {
        using HttpRequestMessage request = new HttpRequestMessage(HttpMethod.Get, url);
        using HttpResponseMessage response = client.Send(request);

        if (!response.IsSuccessStatusCode)
        {
            throw new Exception($"Сервер {url} вернул ошибку: {(int)response.StatusCode} {response.ReasonPhrase}");
        }

        using Stream stream = response.Content.ReadAsStream();
        using StreamReader reader = new StreamReader(stream);

        return reader.ReadToEnd();
    }
}
