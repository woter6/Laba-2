using System;
using System.Diagnostics;
using System.Threading;

class Program
{
    private const int Start = 1;
    private const int End = 10000;
    private const int ThreadCount = 4;

    private static int primeCount = 0;

    private static readonly object monitorLock = new object();
    private static readonly Mutex mutex = new Mutex();
    private static readonly Semaphore semaphore = new Semaphore(1, 1);

    static void Main()
    {
        Console.WriteLine("Задание 1.1");
        Console.WriteLine("1 - Monitor");
        Console.WriteLine("2 - Mutex");
        Console.WriteLine("3 - Semaphore");
        Console.Write("Выберите версию: ");

        string choice = Console.ReadLine();

        if (choice == "1")
            RunVersion("Monitor");
        else if (choice == "2")
            RunVersion("Mutex");
        else if (choice == "3")
            RunVersion("Semaphore");
        else
            Console.WriteLine("Неверный выбор.");
    }

    static void RunVersion(string syncType)
    {
        primeCount = 0;

        Thread[] threads = new Thread[ThreadCount];
        Stopwatch stopwatch = Stopwatch.StartNew();

        int totalNumbers = End - Start + 1;
        int partSize = totalNumbers / ThreadCount;

        for (int i = 0; i < ThreadCount; i++)
        {
            int threadNumber = i + 1;
            int rangeStart = Start + i * partSize;
            int rangeEnd;

            if (i == ThreadCount - 1)
                rangeEnd = End;
            else
                rangeEnd = rangeStart + partSize - 1;

            threads[i] = new Thread(() =>
            {
                ProcessRange(threadNumber, rangeStart, rangeEnd, syncType);
            });

            threads[i].Start();
        }

        for (int i = 0; i < ThreadCount; i++)
        {
            threads[i].Join();
        }

        stopwatch.Stop();

        Console.WriteLine();
        Console.WriteLine($"Общее количество простых чисел: {primeCount}");
        Console.WriteLine($"Время выполнения: {stopwatch.ElapsedMilliseconds} мс");
    }

    static void ProcessRange(int threadNumber, int rangeStart, int rangeEnd, string syncType)
    {
        for (int number = rangeStart; number <= rangeEnd; number++)
        {
            Console.WriteLine($"Поток {threadNumber}: проверяется число {number}");

            if (IsPrime(number))
            {
                AddPrime(syncType);
                Console.WriteLine($"Поток {threadNumber}: найдено простое число {number}");
            }
        }
    }

    static void AddPrime(string syncType)
    {
        if (syncType == "Monitor")
        {
            Monitor.Enter(monitorLock);
            try
            {
                primeCount++;
            }
            finally
            {
                Monitor.Exit(monitorLock);
            }
        }
        else if (syncType == "Mutex")
        {
            mutex.WaitOne();
            try
            {
                primeCount++;
            }
            finally
            {
                mutex.ReleaseMutex();
            }
        }
        else if (syncType == "Semaphore")
        {
            semaphore.WaitOne();
            try
            {
                primeCount++;
            }
            finally
            {
                semaphore.Release();
            }
        }
    }

    static bool IsPrime(int number)
    {
        if (number < 2)
            return false;

        for (int i = 2; i * i <= number; i++)
        {
            if (number % i == 0)
                return false;
        }

        return true;
    }
}
