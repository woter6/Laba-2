using System;
using System.Diagnostics;
using System.Net.Http;
using System.Threading.Tasks;

class Program
{
    static async Task Main()
    {
        Console.WriteLine("Задание 2. Асинхронная версия");

        string[] urls =
        {
            "https://jsonplaceholder.typicode.com/posts/1",
            "https://api.github.com/repos/dotnet/runtime",
            "https://catfact.ninja/fact"
        };

        Stopwatch stopwatch = Stopwatch.StartNew();

        try
        {
            using HttpClient client = new HttpClient();
            client.DefaultRequestHeaders.UserAgent.ParseAdd("CSharpConsoleApp");

            Task<string>[] tasks =
            {
                GetJsonAsync(client, urls[0]),
                GetJsonAsync(client, urls[1]),
                GetJsonAsync(client, urls[2])
            };

            string[] results = await Task.WhenAll(tasks);

            for (int i = 0; i < results.Length; i++)
            {
                Console.WriteLine();
                Console.WriteLine($"Ответ от сервера: {urls[i]}");
                Console.WriteLine(results[i]);
            }

            stopwatch.Stop();

            Console.WriteLine();
            Console.WriteLine($"Общее время работы: {stopwatch.ElapsedMilliseconds} мс");
        }
        catch (Exception ex)
        {
            stopwatch.Stop();

            Console.WriteLine();
            Console.WriteLine("Ошибка при выполнении запроса:");
            Console.WriteLine(ex.Message);
            Console.WriteLine($"Время до ошибки: {stopwatch.ElapsedMilliseconds} мс");
        }
    }

    static async Task<string> GetJsonAsync(HttpClient client, string url)
    {
        HttpResponseMessage response = await client.GetAsync(url);

        if (!response.IsSuccessStatusCode)
        {
            throw new Exception($"Сервер {url} вернул ошибку: {(int)response.StatusCode} {response.ReasonPhrase}");
        }

        return await response.Content.ReadAsStringAsync();
    }
}
